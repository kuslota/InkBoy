CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FATFS_LFN_HEAP=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_GAMEBOY_USB_SERIAL_HOST=y
# The 30 fps grayscale path needs internal-RAM speed for the emulator graphics.
CONFIG_GAMEBOY_GRAPHICS_INTERNAL_RAM=y

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
# Keeps internal RAM free for the display and emulator.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# Scale the CPU while idle; menu_idle controls when automatic light sleep is safe.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Long plane transfers sleep on the SPI interrupt instead of polling.
CONFIG_SSD1681_EXPERIMENTAL_INTERRUPT_FRAME_TX=y
# Match the measured menu-sleep configuration; retain CPU state across light sleep.
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n
